# Copy to .env.local and fill in. Never commit .env.local.

# Shared prototype access code (PRD §6.1). Validated server-side only and never
# bundled into client JavaScript. Login refuses every attempt while this is unset.
LEADERBOARD_PASSWORD=

# HMAC signing key for the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left unset, the server signs with a random per-process key instead, so sessions
# will not survive a restart.
AUTH_SECRET=
